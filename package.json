{
  "name": "luna-flow-docs",
  "private": true,
  "type": "module",
  "description": "Documentation site for the Luna-Flow MoonBit ecosystem: gettext-localized manuals, attachments and the library directory.",
  "workspaces": [
    "tools/lunadoc"
  ],
  "scripts": {
    "prepare-docs": "node tools/prepare-site.mjs",
    "dev": "npm run prepare-docs && astro dev",
    "build": "npm run prepare-docs && astro build && node tools/finalize-site.mjs && pagefind --site dist",
    "preview": "astro preview",
    "site:update-po": "node tools/lunadoc/cli.mjs update --site .",
    "test": "node --test tools/lunadoc/test/*.test.mjs"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@xmldom/xmldom": "^0.8.15",
    "astro": "^7.3.6",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.19.0",
    "pagefind": "^1.5.2",
    "pdfjs-dist": "^6.4.299",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0"
  }
}
