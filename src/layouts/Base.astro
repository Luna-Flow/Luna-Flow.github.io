---
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Search from '../components/Search.astro';
import { locales, localeOf, switchUrl, t } from '../lib/site';

interface Props {
  lang: string;
  title: string;
  description?: string;
  url: string;
  bodyClass?: string;
}

const { lang, title, description, url, bodyClass } = Astro.props;
const locale = localeOf(lang);
const siteName = t(lang, 'site.name');
const fullTitle = title === siteName ? siteName : `${title} · ${siteName}`;
// CJK pages: sans for body text, serif only for headings (one weight).
const cjk = locale.lang.startsWith('zh')
  ? 'Noto+Sans+SC:wght@400;500;600&family=Noto+Serif+SC:wght@600'
  : locale.lang.startsWith('ja')
    ? 'Noto+Sans+JP:wght@400;500;600&family=Noto+Serif+JP:wght@600'
    : null;
const fonts =
  'https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500' +
  (cjk ? `&family=${cjk}` : '') +
  '&display=swap';
---

<!doctype html>
<html lang={locale.lang} data-locale={locale.path}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description || t(lang, 'site.description')} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(url, Astro.site)} />
    {locales.map((other) => <link rel="alternate" hreflang={other.lang} href={new URL(switchUrl(url, other), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(switchUrl(url, locales[0]), Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('lf-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#content">{t(lang, 'nav.skip')}</a>
    <Header lang={lang} url={url} />
    <slot />
    <footer class="site-footer">
      <p>{t(lang, 'footer.text')}</p>
    </footer>
    <Search lang={lang} />
  </body>
</html>
